config wifi-device 'radio0'
    option type 'ralink'
    option variant 'mt7628'
    option country 'US'
    option hwmode '11g'
    option htmode 'HT40'
    option channel 'auto'
    option disabled '1'
    option device_mode 'apsta'
    option op_mode 'preference'

config wifi-iface 'ap'
    option device 'radio0'
    option network 'wlan'
    option ifname 'ra0'
    option mode 'ap'
    option encryption 'psk2'
    option key '12345678'
    option ApCliEnable '1'
    option ApCliSsid 'yourwifissid'
    option ApCliAuthMode 'WPA2PSK'
    option ApCliEncrypType 'AES'
    option ApCliPassWord 'yourpassword'
    option ssid 'abs_eth_serial'

