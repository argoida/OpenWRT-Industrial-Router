config defaults
    option syn_flood    1
    option input        DROP
    option output       ACCEPT
    option forward      DROP
# Uncomment this line to disable ipv6 rules
    option disable_ipv6 1

# Todas as zonas menos a ipsec tera a possibilidade de ACCEPT de forward, mas deixaremos isso desligado na sessao
config zone
    option name         wlan
    list   network      wlan
    option input        DROP
    option output       ACCEPT
    option forward      ACCEPT

config zone
    option name         wan
    list   network      'wan'
    option input        DROP
    option output       ACCEPT
    option forward      ACCEPT
    option masq         1
    option mtu_fix      1

config zone
    option name         wanCel
    list   network      'wanCel'
    option input        DROP
    option output       ACCEPT
    option forward      ACCEPT
    option masq         1
    option mtu_fix      1

config zone
    option name         ipsec
    list   network      'ipsec'
    option input        DROP
    option output       ACCEPT
    option forward      ACCEPT
    option masq         1
    option mtu_fix      1

config zone
    option name         'openvpn_fw'
    list network        'openvpn'
    option input        DROP
    option output       ACCEPT
    option forward      ACCEPT

config zone
    option name         'wanEth'
    list network        'wanEth'
    option input        DROP
    option output       ACCEPT
    option forward      ACCEPT

config forwarding
    option src          'wan'
    option dest         'openvpn_fw'
    option enabled      '0'

config forwarding
    option src          'openvpn_fw'
    option dest         'wan'
    option enabled      '0'

config forwarding
