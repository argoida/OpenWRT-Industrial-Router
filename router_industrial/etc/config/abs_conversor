
config worker 'serial_publica'
	option name 'serial_publica'
	option tipo 'serial_publica'
	option baudrate '9600'
	option cs '8'
	option par 'none'
	option stopbit '1'
	list jumpers 'tcp_client'

config worker 'serial_abs'
	option name 'serial_abs'
	option tipo 'serial_abs'
	list jumpers 'tcp_client'

config worker 'ftp'
	option tipo 'ftp'
	option name 'ftp'
	option usemode 'off'
	option trigger 'ABSMSGNS'
	option trigger_user 'ftpput/a'
	option hostname ''
	option hostport ''
	option timeout '60'
	option user ''
	option password ''
	option dir ''
	option filename ''
	option transfer_cmd 'APPE'

config worker 'http'
	option tipo 'http'
	option name 'http'
	option usemode 'off'
	option trigger 'ABSMSGNS'
	option trigger_user 'httpsend'
	option hostname ''
	option hostport ''
	option timeout '60'
	option caminho ''
	option station ''
	option query_string ''

config worker 'tcp_server_internal'
	option tipo 'tcp_server_internal'
	option name 'tcp_server_internal'

config worker 'tcp_client'
	option name 'tcp_client'
	option tipo 'tcp_client'
	option idletimeout '90'
	option hosttype '0'
	option login 'UserLogin'
	list hostname_and_port 'gprs.yourgateway.com:5901'
	list jumpers 'serial_publica'
	list jumpers 'serial_abs'
